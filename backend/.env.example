PORT=5000

# --- PostgreSQL (pick ONE style) ---
# Style A: single connection URL (recommended for Neon / Supabase / Railway / local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_sales_agent

# Style B: discrete vars (used only if DATABASE_URL is empty)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=ai_sales_agent

# Set true for managed Postgres (Neon, Supabase, etc.)
DATABASE_SSL=false

# Fail startup instead of falling back to in-memory store
REQUIRE_POSTGRES=false

# Python AI service (Gemini language layer)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=8000

# Simulated latency of the create_booking API (assignment says ~1-2s)
BOOKING_LATENCY_MS=1500

CORS_ORIGIN=http://localhost:5173
